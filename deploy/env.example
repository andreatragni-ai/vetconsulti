# /etc/consulti/env — variabili NON segrete (root:consulti 640)
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ALLOWED_HOSTS=consulti.vetway.it
DJANGO_DB_NAME=consulti_db
DJANGO_DB_USER=consulti
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

CONSULTI_BASE_URL=https://consulti.vetway.it
CONSULTI_ORE_PRESA_IN_CARICO=24
FFMPEG_BIN=/usr/bin/ffmpeg
UPLOAD_MAX_BYTE=314572800
ALLEGATO_MAX_BYTE=52428800

EMAIL_HOST=authsmtp.securemail.pro
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Tra virgolette: il valore ha spazi e parentesi angolari. systemd le toglie
# da solo; senza, il `set -a; . /etc/consulti/env` di INSTALLAZIONE.md si
# ferma qui con un errore di sintassi e le variabili sotto non arrivano.
EMAIL_FROM="VetWay Consulti <noreply@vetway.it>"
EMAIL_REPLY_TO=consulti@vetway.it
EMAIL_SERVER=errori@vetway.it
EMAIL_ERRORS=errori@vetway.it

# Storage S3 (Hetzner) — lasciare vuoto finche' non si attiva in prod.py
# S3_BUCKET=
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=fsn1
